# --- Database (Neon / Supabase / any PostgreSQL) ---
# Neon:     postgresql://user:pass@ep-xxx.aws.neon.tech/crewfall?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Local:    postgresql://crewfall:crewfall@localhost:5432/crewfall
DATABASE_URL="postgresql://crewfall:crewfall@localhost:5432/crewfall"

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-real-secret"
# Canonical URL of the web app (used by Auth.js redirects)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Realtime ---
# Where the browser connects for Socket.IO. Leave empty to use same-origin
# (Docker / node self-host). Set to the realtime server URL when the web app
# is on Vercel, e.g. https://realtime.your-domain.com
NEXT_PUBLIC_SOCKET_URL=""
# Comma-separated origins allowed to connect to the realtime server.
SOCKET_CORS_ORIGINS="http://localhost:3000"

# --- Server ---
PORT="3000"
# Set to 1 to run the realtime server only (no Next.js) — used when the web
# app is deployed to Vercel and the game server is hosted separately.
REALTIME_ONLY=""

# --- Optional: Vercel Blob (user-uploaded avatars etc.) ---
BLOB_READ_WRITE_TOKEN=""
