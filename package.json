{
  "name": "hollowmoor",
  "version": "1.0.0",
  "private": true,
  "description": "HOLLOWMOOR — an original browser survival-horror game. First-person, adaptive stalker AI, storm-soaked estate, fully procedural art and audio (zero binary assets). Next.js 15 + React Three Fiber + Rapier.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:level": "tsx scripts/validate-level.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "framer-motion": "^12.4.10",
    "howler": "^2.2.4",
    "leva": "^0.10.1",
    "n8ao": "^1.10.3",
    "next": "^15.5.0",
    "postprocessing": "^6.39.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
