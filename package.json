{
  "name": "crewfall",
  "version": "1.0.0",
  "private": true,
  "description": "Crewfall — an open-source social deduction game inspired by Among Us. Authoritative multiplayer server, Next.js 15 client, original vector assets.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "realtime": "cross-env NODE_ENV=production REALTIME_ONLY=1 tsx server/index.ts",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.4.10",
    "jose": "^6.0.10",
    "nanoid": "^5.1.3",
    "next": "^15.3.3",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
